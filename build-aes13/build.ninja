# =============================================================================
# Link build statements for STATIC_LIBRARY target ipl-source


#############################################
# Link the static library lib/libipl-source.a

build lib/libipl-source.a: CXX_STATIC_LIBRARY_LINKER__ipl-source_Release src/operation/iPL/source/CMakeFiles/ipl-source.dir/PlacerDB.cc.o || lib/libipl-center_placer.a
  CONFIG = Release
  LANGUAGE_COMPILE_FLAGS = -fopenmp  -O3 -Wall -Werror=return-type
  OBJECT_DIR = src/operation/iPL/source/CMakeFiles/ipl-source.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libipl-source.a
  TARGET_PDB = ipl-source.a.dbg
  TARGET_SUPPORT_DIR = src/operation/iPL/source/CMakeFiles/ipl-source.dir


